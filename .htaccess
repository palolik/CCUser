# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION BEGIN
PassengerAppRoot "/home/mauvsajy/cloudcompany.cc"
PassengerBaseURI "/"
PassengerNodejs "/home/mauvsajy/nodevenv/cloudcompany.cc/22/bin/node"
PassengerAppType node
PassengerStartupFile index.html
# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION END

# DO NOT REMOVE OR MODIFY. CLOUDLINUX ENV VARS CONFIGURATION BEGIN
<IfModule Litespeed>
</IfModule>
# DO NOT REMOVE OR MODIFY. CLOUDLINUX ENV VARS CONFIGURATION END



# /blog has both blog.html and a blog/ folder of posts: don't redirect /blog to /blog/.
DirectorySlash Off

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve the pre-rendered page for /some/path from some/path.html
  # (generated by scripts/seo-build.mjs) so crawlers get real content and meta tags.
  RewriteCond %{REQUEST_URI} !\.html$
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]

  # Anything that isn't a real file (including folders like /blog/) goes to
  # index.html so React Router can handle it.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.html [L]
</IfModule>
